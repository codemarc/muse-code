{
  "name": "muse-cli-chat",
  "displayName": "Muse CLI Chat",
  "description": "Unofficial VS Code / Cursor sidebar for Meta Muse Code. Wraps the muse CLI (muse exec --json); not affiliated with Meta.",
	"version": "0.2.0",
  "publisher": "codemarc",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codemarc/muse-code.git"
  },
  "bugs": {
    "url": "https://github.com/codemarc/muse-code/issues"
  },
  "homepage": "https://github.com/codemarc/muse-code",
  "qna": "https://github.com/codemarc/muse-code/blob/main/PRIVACY.md",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "muse",
    "muse-code",
    "meta",
    "ai",
    "coding-agent",
    "cli"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Muse CLI Chat runs a local coding agent that can edit files and execute commands in the workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Muse Code requires a local filesystem workspace."
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "muse-activity",
          "title": "Muse CLI Chat",
          "icon": "media/muse.svg"
        }
      ]
    },
    "views": {
      "muse-activity": [
        {
          "type": "webview",
          "id": "muse.chatView",
          "name": "Muse"
        }
      ]
    },
    "commands": [
      {
        "command": "muse.openChat",
        "title": "Muse CLI Chat: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "muse.open",
        "title": "Muse CLI Chat: Open",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "muse.openPanel",
        "title": "Muse CLI Chat: Open in Editor Panel",
        "icon": "$(open-preview)"
      },
      {
        "command": "muse.openEditor",
        "title": "Muse: Open Editor Tab",
        "icon": "$(open-preview)"
      },
      {
        "command": "muse.openSecondarySidebar",
        "title": "Muse CLI Chat: Open in Sidebar",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "muse.openNewWindow",
        "title": "Muse CLI Chat: Open in New Window",
        "icon": "$(window)"
      },
      {
        "command": "muse.sendSelection",
        "title": "Muse CLI Chat: Send Selection"
      },
      {
        "command": "muse.newSession",
        "title": "Muse CLI Chat: New Session",
        "icon": "$(add)"
      },
      {
        "command": "muse.stop",
        "title": "Muse CLI Chat: Stop",
        "icon": "$(debug-stop)"
      },
      {
        "command": "muse.openInteractiveTerminal",
        "title": "Muse CLI Chat: Open Interactive Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "muse.openMuseAi",
        "title": "Muse CLI Chat: Copy Session and Open Muse.ai",
        "icon": "$(link-external)"
      },
      {
        "command": "muse.openWebsite",
        "title": "Muse CLI Chat: Open Website",
        "icon": "$(globe)"
      },
      {
        "command": "muse.openBilling",
        "title": "Muse CLI Chat: Open Billing",
        "icon": "$(credit-card)"
      },
      {
        "command": "muse.checkInstallation",
        "title": "Muse CLI Chat: Check Installation"
      },
      {
        "command": "muse.selectWorkspaceFolder",
        "title": "Muse CLI Chat: Select Workspace Folder",
        "icon": "$(folder)"
      },
      {
        "command": "muse.pickSession",
        "title": "Muse CLI Chat: Resume Session",
        "icon": "$(history)"
      },
      {
        "command": "muse.cleanupSessions",
        "title": "Muse CLI Chat: Clean Up Sessions",
        "icon": "$(trash)"
      },
      {
        "command": "muse.openInCanvas",
        "title": "Muse CLI Chat: Open Last Tool Result in Canvas",
        "icon": "$(open-preview)"
      },
      {
        "command": "muse.expandAll",
        "title": "Muse CLI Chat: Expand All",
        "icon": "$(expand-all)"
      },
      {
        "command": "muse.collapseAll",
        "title": "Muse CLI Chat: Collapse All",
        "icon": "$(collapse-all)"
      },
      {
        "command": "muse.exportTranscript",
        "title": "Muse: Export Session Transcript",
        "icon": "$(export)"
      },
      {
        "command": "muse.copyRequestId",
        "title": "Muse: Copy Request ID",
        "icon": "$(clippy)"
      },
      {
        "command": "muse.openSettings",
        "title": "Muse: Agent Settings",
        "icon": "$(gear)"
      }
    ],
    "keybindings": [
      {
        "command": "muse.openPanel",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "muse.open",
          "when": "false"
        },
        {
          "command": "muse.openEditor",
          "when": "false"
        },
        {
          "command": "muse.openPanel"
        },
        {
          "command": "muse.openSecondarySidebar"
        },
        {
          "command": "muse.openNewWindow"
        }
      ],
      "view/title": [
        {
          "command": "muse.selectWorkspaceFolder",
          "when": "view =~ /muse\\.chatView/ && workspaceFolderCount > 1",
          "group": "navigation@0"
        },
        {
          "command": "muse.pickSession",
          "when": "view =~ /muse\\.chatView/",
          "group": "navigation@1"
        },
        {
          "command": "muse.cleanupSessions",
          "when": "view =~ /muse\\.chatView/",
          "group": "navigation@2"
        },
        {
          "command": "muse.openInCanvas",
          "when": "view =~ /muse\\.chatView/",
          "group": "navigation@3"
        },
        {
          "command": "muse.expandAll",
          "when": "view =~ /muse\\.chatView/",
          "group": "navigation@4"
        },
        {
          "command": "muse.collapseAll",
          "when": "view =~ /muse\\.chatView/",
          "group": "navigation@5"
        },
        {
          "command": "muse.openPanel",
          "when": "view =~ /muse\\.chatView/",
          "group": "navigation"
        },
        {
          "command": "muse.newSession",
          "when": "view =~ /muse\\.chatView/",
          "group": "navigation"
        },
        {
          "command": "muse.stop",
          "when": "view =~ /muse\\.chatView/",
          "group": "navigation"
        },
        {
          "command": "muse.openInteractiveTerminal",
          "when": "view =~ /muse\\.chatView/",
          "group": "navigation"
        },
        {
          "command": "muse.openMuseAi",
          "when": "view =~ /muse\\.chatView/",
          "group": "navigation"
        },
        {
          "command": "muse.openWebsite",
          "when": "view =~ /muse\\.chatView/",
          "group": "navigation"
        },
        {
          "command": "muse.openBilling",
          "when": "view =~ /muse\\.chatView/",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "muse.open",
          "group": "navigation"
        },
        {
          "command": "muse.openEditor",
          "when": "activeWebviewPanelId == muse.chatPanel",
          "group": "navigation@1"
        },
        {
          "command": "muse.exportTranscript",
          "when": "activeWebviewPanelId == muse.chatPanel",
          "group": "muse@1"
        },
        {
          "command": "muse.copyRequestId",
          "when": "activeWebviewPanelId == muse.chatPanel",
          "group": "muse@2"
        },
        {
          "command": "muse.openSettings",
          "when": "activeWebviewPanelId == muse.chatPanel",
          "group": "muse@3"
        }
      ],
      "editor/context": [
        {
          "command": "muse.sendSelection",
          "when": "editorHasSelection",
          "group": "muse@1"
        }
      ],
      "explorer/context": [
        {
          "command": "muse.open",
          "group": "muse@1"
        }
      ]
    },
    "configuration": {
      "title": "Muse CLI Chat",
      "properties": {
        "muse.executablePath": {
          "type": "string",
          "default": "muse",
          "scope": "application",
          "description": "Path to the Muse Code binary. Use \"muse\" (PATH) or an absolute path to the binary file. Application-scoped so workspaces cannot override it."
        },
        "muse.preferredLocation": {
          "type": "string",
          "enum": [
            "secondarySidebar",
            "panel",
            "terminal"
          ],
          "enumDescriptions": [
            "Open the native chat in the sidebar.",
            "Open the native chat in an editor panel.",
            "Open the Muse interactive terminal."
          ],
          "default": "secondarySidebar",
          "description": "Where Muse CLI Chat opens when using the Open Chat command."
        },
        "muse.useTerminal": {
          "type": "boolean",
          "default": false,
          "description": "Open Muse in an integrated terminal instead of the native chat when Open Chat is used. Legacy alias for muse.executionMode = interactive."
        },
        "muse.executionMode": {
          "type": "string",
          "enum": [
            "headless",
            "interactive"
          ],
          "enumDescriptions": [
            "Native chat runs muse exec --json. Interactive approvals are unavailable.",
            "Open Chat uses the integrated Muse terminal so Muse can ask for approvals and other interactive input."
          ],
          "default": "headless",
          "description": "How Muse CLI Chat executes. Headless is the default JSONL native-chat path. Interactive opens the Muse terminal. MSP is not exposed yet."
        },
        "muse.model": {
          "type": "string",
          "default": "",
          "description": "Optional model id passed to muse exec --model. Empty uses Muse defaults."
        },
        "muse.reasoningEffort": {
          "type": "string",
          "enum": [
            "",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "ultra"
          ],
          "default": "",
          "description": "Optional --reasoning-effort for muse exec. Empty uses Muse default (high)."
        },
        "muse.trustWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Pass --trust-workspace so project skills, rules, and AGENTS.md load."
        },
        "muse.disableApproval": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "Pass `--disable-approval` for headless sidebar runs (sandbox stays on unless yolo is enabled). Defaults off; the extension prompts on first send. Prefer **Open Interactive Terminal** for staged approvals. Application-scoped."
        },
        "muse.yolo": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "**Dangerous.** Pass `--yolo` (disables approval and sandbox, trusts workspace). Prefer `disableApproval` with the OS sandbox. Application-scoped so workspaces cannot enable it."
        },
        "muse.useEchoProvider": {
          "type": "boolean",
          "default": false,
          "description": "Use --provider echo for offline UI testing (no Meta API)."
        },
        "muse.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "markdownDescription": "Extra argv appended to `muse exec`. Application-scoped. `--yolo` and `--disable-sandbox` are blocked here; use `muse.yolo` instead."
        },
        "muse.toolOutputFormat": {
          "type": "string",
          "enum": [
            "readable",
            "json"
          ],
          "default": "readable",
          "description": "Default view for tool results in the chat sidebar. Readable shows terminal-style output for shell/exec results; JSON shows the raw payload. Each tool card can still toggle views."
        },
        "muse.toolDisplay": {
          "type": "string",
          "enum": [
            "minimal",
            "compact",
            "balanced",
            "detailed"
          ],
          "enumDescriptions": [
            "Dense one-line rows with no expansion; silent runs collapse to a working pulse.",
            "Fold every tool result to a one-line summary.",
            "Open short tool results and fold long results.",
            "Open every tool result."
          ],
          "default": "compact",
          "description": "How tool results are initially disclosed in chat. Minimal rows do not expand; every other card can still be opened or folded individually."
        },
        "muse.chatFormat": {
          "type": "string",
          "enum": [
            "markdown",
            "plain"
          ],
          "default": "markdown",
          "description": "How assistant messages render in the sidebar. Markdown shows headings, lists, and code blocks (sanitized). Plain keeps raw text."
        }
      }
    }
  },
  "scripts": {
    "compile": "bun run esbuild.mjs",
    "compile:prod": "NODE_ENV=production bun run esbuild.mjs",
    "watch": "bun run esbuild.mjs --watch",
    "check": "tsc -p . --noEmit",
    "test": "bun test src/",
    "package": "bun run check && bun run test && bun run compile:prod && bunx vsce package --no-dependencies",
    "publish:ovsx": "bun run package && bunx ovsx publish *.vsix",
    "publish:vscode": "bun run package && bunx vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.3.2",
    "esbuild": "^0.25.1",
    "typescript": "^5.8.2"
  }
}
